    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.59.0",
    "vite": "^5.4.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.147.0"
  }
