{
  // Serveur du classement (GAME_SPEC §23). Rejoue chaque partie soumise avec le même module src/sim
  // que le client et n'enregistre que les scores confirmés par le rejeu.
  "name": "pluie-de-chats-classement",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pluie-de-chats",
      // À REMPLACER par l'id renvoyé par `npx wrangler d1 create pluie-de-chats` (compte Cloudflare requis).
      // L'id nul ci-dessous ne sert qu'au développement local.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://sderosiaux.github.io,http://localhost:5173,http://localhost:4173"
  }
}
